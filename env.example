# Copy to .env for local testing if you prefer environment variables over
# .streamlit/secrets.toml. .env is git-ignored - never commit real keys.
# (App.py checks st.secrets first, then falls back to os.environ, so
# either method works locally; only real env vars work on Render.)

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
ADMIN_PASSWORD=choose-a-staff-password

# --- ElevenLabs (TESSA's voice) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-chosen-caribbean-female-voice-id-here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
