# Copy this file to .streamlit/secrets.toml for LOCAL TESTING ONLY.
# .streamlit/secrets.toml is git-ignored - never commit real keys.
# In production (Render), set these as Environment Variables instead
# (see RENDER_DEPLOY.md) - Streamlit reads st.secrets OR os.environ,
# so the same code works in both places.

GEMINI_API_KEY = "your-gemini-api-key-here"
ADMIN_PASSWORD = "choose-a-staff-password"

# --- ElevenLabs (TESSA's voice) ---
ELEVENLABS_API_KEY = "your-elevenlabs-api-key-here"
ELEVENLABS_VOICE_ID = "your-chosen-caribbean-female-voice-id-here"
